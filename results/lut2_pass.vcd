$var real 64 & v_a $end
$var real 64 ' v_b $end
$var real 64 ( v_n0 $end
$var real 64 ) v_n1 $end
$var real 64 * v_yi $end
$var real 64 + v_yb $end
$var real 64 , v_y $end
$upscope $end
$enddefinitions $end
