$var real 64 0 v_yb $end
$var real 64 1 v_y $end
$var real 64 2 v_t0 $end
$var real 64 3 v_t1 $end
$var real 64 4 v_t2 $end
$var real 64 5 v_t3 $end
$upscope $end
$enddefinitions $end
