"""
Look-up table with two inputs: Y = T[2 B + A].

    T0 --[A=0]--+
                +-- N0 --[B=0]--+
    T1 --[A=1]--+               +-- YI --|>o--|>o-- Y
    T2 --[A=0]--+               |
                +-- N1 --[B=1]--+
    T3 --[A=1]--+

Three variants, as in lut.py: transmission gates, pass transistors, and
transmission gates with the table stored in SRAM cells.
"""
import ElectricPower
from "blocks.ato" import Inverter, Mux2Tgate, Mux2Pass, Buffer, SramCell

module Lut2Tgate:
    power = new ElectricPower
    signal A
    signal B
    signal T0
    signal T1
    signal T2
    signal T3
    signal Y
    signal AN
    signal BN
    signal N0
    signal N1
    signal YI

    # names of the nets, as in the KiCad schematic
    A.override_net_name = "A"
    B.override_net_name = "B"
    T0.override_net_name = "T0"
    T1.override_net_name = "T1"
    T2.override_net_name = "T2"
    T3.override_net_name = "T3"
    Y.override_net_name = "Y"
    AN.override_net_name = "AN"
    BN.override_net_name = "BN"
    N0.override_net_name = "N0"
    N1.override_net_name = "N1"
    YI.override_net_name = "YI"
    power.hv.override_net_name = "VDD"
    power.lv.override_net_name = "GND"
    buffer.MID.override_net_name = "BUFFER_MID"

    inv_a = new Inverter
    inv_b = new Inverter
    mux_n0 = new Mux2Tgate
    mux_n1 = new Mux2Tgate
    mux_y = new Mux2Tgate
    buffer = new Buffer
    power ~ inv_a.power
    power ~ inv_b.power
    power ~ mux_n0.power
    power ~ mux_n1.power
    power ~ mux_y.power
    power ~ buffer.power

    inv_a.IN ~ A
    inv_a.OUT ~ AN
    inv_b.IN ~ B
    inv_b.OUT ~ BN

    mux_n0.IN0 ~ T0
    mux_n0.IN1 ~ T1
    mux_n0.SEL ~ A
    mux_n0.SEL_N ~ AN
    mux_n0.OUT ~ N0

    mux_n1.IN0 ~ T2
    mux_n1.IN1 ~ T3
    mux_n1.SEL ~ A
    mux_n1.SEL_N ~ AN
    mux_n1.OUT ~ N1

    mux_y.IN0 ~ N0
    mux_y.IN1 ~ N1
    mux_y.SEL ~ B
    mux_y.SEL_N ~ BN
    mux_y.OUT ~ YI

    buffer.IN ~ YI
    buffer.OUT ~ Y

module Lut2Pass:
    power = new ElectricPower
    signal A
    signal B
    signal T0
    signal T1
    signal T2
    signal T3
    signal Y
    signal AN
    signal BN
    signal N0
    signal N1
    signal YI

    # names of the nets, as in the KiCad schematic
    A.override_net_name = "A"
    B.override_net_name = "B"
    T0.override_net_name = "T0"
    T1.override_net_name = "T1"
    T2.override_net_name = "T2"
    T3.override_net_name = "T3"
    Y.override_net_name = "Y"
    AN.override_net_name = "AN"
    BN.override_net_name = "BN"
    N0.override_net_name = "N0"
    N1.override_net_name = "N1"
    YI.override_net_name = "YI"
    power.hv.override_net_name = "VDD"
    power.lv.override_net_name = "GND"
    buffer.MID.override_net_name = "BUFFER_MID"

    inv_a = new Inverter
    inv_b = new Inverter
    mux_n0 = new Mux2Pass
    mux_n1 = new Mux2Pass
    mux_y = new Mux2Pass
    buffer = new Buffer
    power ~ inv_a.power
    power ~ inv_b.power
    power ~ mux_n0.power
    power ~ mux_n1.power
    power ~ mux_y.power
    power ~ buffer.power

    inv_a.IN ~ A
    inv_a.OUT ~ AN
    inv_b.IN ~ B
    inv_b.OUT ~ BN

    mux_n0.IN0 ~ T0
    mux_n0.IN1 ~ T1
    mux_n0.SEL ~ A
    mux_n0.SEL_N ~ AN
    mux_n0.OUT ~ N0

    mux_n1.IN0 ~ T2
    mux_n1.IN1 ~ T3
    mux_n1.SEL ~ A
    mux_n1.SEL_N ~ AN
    mux_n1.OUT ~ N1

    mux_y.IN0 ~ N0
    mux_y.IN1 ~ N1
    mux_y.SEL ~ B
    mux_y.SEL_N ~ BN
    mux_y.OUT ~ YI

    buffer.IN ~ YI
    buffer.OUT ~ Y

module Lut2Sram from Lut2Tgate:
    """The table bits T0..T3 are the outputs of four SRAM cells."""
    signal BL
    signal BLN
    signal WL0
    signal WL1
    signal WL2
    signal WL3

    BL.override_net_name = "BL"
    BLN.override_net_name = "BLN"
    WL0.override_net_name = "WL0"
    WL1.override_net_name = "WL1"
    WL2.override_net_name = "WL2"
    WL3.override_net_name = "WL3"

    cell0 = new SramCell
    cell1 = new SramCell
    cell2 = new SramCell
    cell3 = new SramCell
    power ~ cell0.power
    power ~ cell1.power
    power ~ cell2.power
    power ~ cell3.power

    cell0.BL ~ BL
    cell0.BLN ~ BLN
    cell0.WL ~ WL0
    cell0.Q ~ T0
    cell1.BL ~ BL
    cell1.BLN ~ BLN
    cell1.WL ~ WL1
    cell1.Q ~ T1
    cell2.BL ~ BL
    cell2.BLN ~ BLN
    cell2.WL ~ WL2
    cell2.Q ~ T2
    cell3.BL ~ BL
    cell3.BLN ~ BLN
    cell3.WL ~ WL3
    cell3.Q ~ T3
