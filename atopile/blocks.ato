"""
Building blocks of the look-up table.

Every module has the supply `power` and signals for its ports. The names of
modules, instances and ports are the same as in the KiCad sheets generated
from lut.py, so the two descriptions can be compared part by part.
"""
import ElectricPower
from "parts/MOS4/MOS4.ato" import NMOS4, PMOS4

module Inverter:
    """CMOS inverter: OUT = not IN."""
    power = new ElectricPower
    signal IN
    signal OUT

    qp = new PMOS4
    qn = new NMOS4

    qp.G ~ IN
    qn.G ~ IN
    qp.D ~ OUT
    qn.D ~ OUT
    qp.S ~ power.hv
    qp.B ~ power.hv
    qn.S ~ power.lv
    qn.B ~ power.lv

module SwitchTgate:
    """Transmission gate: IN and OUT are connected when ON = 1 and ON_N = 0."""
    power = new ElectricPower
    signal IN
    signal OUT
    signal ON
    signal ON_N

    qn = new NMOS4
    qp = new PMOS4

    qn.D ~ IN
    qn.S ~ OUT
    qn.G ~ ON
    qn.B ~ power.lv
    qp.S ~ IN
    qp.D ~ OUT
    qp.G ~ ON_N
    qp.B ~ power.hv

module SwitchPass:
    """Pass transistor: IN and OUT are connected when ON = 1. ON_N is not used."""
    power = new ElectricPower
    signal IN
    signal OUT
    signal ON
    signal ON_N

    qn = new NMOS4

    qn.D ~ IN
    qn.S ~ OUT
    qn.G ~ ON
    qn.B ~ power.lv

module Mux2Tgate:
    """2:1 multiplexer: OUT = IN1 if SEL = 1, otherwise IN0."""
    power = new ElectricPower
    signal IN0
    signal IN1
    signal OUT
    signal SEL
    signal SEL_N

    sw0 = new SwitchTgate
    sw1 = new SwitchTgate
    power ~ sw0.power
    power ~ sw1.power

    sw0.IN ~ IN0
    sw0.OUT ~ OUT
    sw0.ON ~ SEL_N
    sw0.ON_N ~ SEL
    sw1.IN ~ IN1
    sw1.OUT ~ OUT
    sw1.ON ~ SEL
    sw1.ON_N ~ SEL_N

module Mux2Pass:
    """2:1 multiplexer from pass transistors."""
    power = new ElectricPower
    signal IN0
    signal IN1
    signal OUT
    signal SEL
    signal SEL_N

    sw0 = new SwitchPass
    sw1 = new SwitchPass
    power ~ sw0.power
    power ~ sw1.power

    sw0.IN ~ IN0
    sw0.OUT ~ OUT
    sw0.ON ~ SEL_N
    sw0.ON_N ~ SEL
    sw1.IN ~ IN1
    sw1.OUT ~ OUT
    sw1.ON ~ SEL
    sw1.ON_N ~ SEL_N

module Buffer:
    """Two inverters in series: restores the level and drives the load."""
    power = new ElectricPower
    signal IN
    signal MID
    signal OUT

    inv1 = new Inverter
    inv2 = new Inverter
    power ~ inv1.power
    power ~ inv2.power

    inv1.IN ~ IN
    inv1.OUT ~ MID
    inv2.IN ~ MID
    inv2.OUT ~ OUT

module SramCell:
    """
    SRAM cell with six transistors: two inverters that hold each other and
    two access transistors to the bit lines, switched by the word line.
    """
    power = new ElectricPower
    signal BL
    signal BLN
    signal WL
    signal Q
    signal QN

    inv_q = new Inverter
    inv_qn = new Inverter
    qa = new NMOS4
    qb = new NMOS4
    power ~ inv_q.power
    power ~ inv_qn.power

    inv_q.IN ~ QN
    inv_q.OUT ~ Q
    inv_qn.IN ~ Q
    inv_qn.OUT ~ QN

    qa.D ~ BL
    qa.S ~ Q
    qa.G ~ WL
    qa.B ~ power.lv
    qb.D ~ QN
    qb.S ~ BLN
    qb.G ~ WL
    qb.B ~ power.lv
